# CodePilot AI Environment Configuration (Safe Template)

# Application
APP_ENV=development
SECRET_KEY=supersecret-codepilot-jwt-key-change-in-production-2026
FERNET_KEY=gAAAAABlZ38S607_aY_Y9K5QJ4_R7Q0R1V4W4X5Y6Z7=
PORT=8000

# Database & Cache
# Local development default: sqlite+aiosqlite:///./codepilot.db
# Production / PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/codepilot_db
DATABASE_URL=sqlite+aiosqlite:///./codepilot.db
REDIS_URL=redis://localhost:6379/0

# Task Queue Mode:
# 'redis' (production-ready queue with Redis and dedicated python -m app.worker process)
# 'background_tasks' (local dev mode using in-process FastAPI BackgroundTasks)
QUEUE_MODE=redis
INDEXING_JOB_TIMEOUT_SECONDS=300
INDEXING_JOB_MAX_RETRIES=2

# LLM & AI Provider Configuration
# options: mock (default for offline dev & tests), azure (real Azure-hosted model)
LLM_PROVIDER=mock

# Embedding Provider Configuration (options: azure, mock; defaults to LLM_PROVIDER if unset)
# When LLM_PROVIDER=azure, set EMBEDDING_PROVIDER=azure to use text-embedding-3-small in Azure AI Foundry
# Set EMBEDDING_PROVIDER=mock for offline local development
EMBEDDING_PROVIDER=mock


# Azure AI Foundry / Azure OpenAI Settings (Required only when LLM_PROVIDER=azure)
# Microsoft Foundry Project format: https://<resource>.services.ai.azure.com/api/projects/<project-name>
# Azure OpenAI format: https://<resource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/your-project-name
AZURE_OPENAI_API_KEY=your-azure-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Azure Embedding Model Deployment (e.g. text-embedding-3-small)
# Note: Chat models like gpt-4.1-mini cannot generate embeddings.
# Deploy 'text-embedding-3-small' in Azure AI Foundry to use real Azure embeddings.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Fallback OpenAI API Key (optional, if using direct openai)
OPENAI_API_KEY=

# GitHub Integration (Optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Demo User Password (Development only)
DEMO_USER_PASSWORD=Password123!

# Ingestion & Security limits
MAX_REPOSITORY_SIZE_MB=50
MAX_FILE_SIZE_KB=1024
RATE_LIMIT_PER_MINUTE=60
