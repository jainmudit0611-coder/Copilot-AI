# CodePilot AI Environment Configuration

# Application
APP_ENV=development
SECRET_KEY=supersecret-codepilot-jwt-key-change-in-production-2026
FERNET_KEY=gAAAAABlZ3...
PORT=8000

# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codepilot_db
REDIS_URL=redis://localhost:6379/0

# LLM & Embeddings (Azure OpenAI or OpenAI Compatible)
LLM_PROVIDER=azure  # options: azure, openai, mock
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Fallback OpenAI API Key (if not using Azure)
OPENAI_API_KEY=

# GitHub Integration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Ingestion & Security limits
MAX_REPOSITORY_SIZE_MB=50
MAX_FILE_SIZE_KB=1024
RATE_LIMIT_PER_MINUTE=60
